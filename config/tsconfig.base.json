{
	"extends": "./tsconfig.strict",
	"compilerOptions": {
		"ignoreDeprecations": "6.0",
		"skipLibCheck": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "es2018",
		"noImplicitAny": true,
		"sourceMap": true,
		"outDir": "../dist",
		"declaration": true,
		"importHelpers": true,
		"listFiles": false,
		"traceResolution": false,
		"pretty": true,
		"lib": ["es6"],
		"types": ["node", "jest"]
	},
	"include": ["../src/**/*.ts"],
	"compileOnSave": false
}

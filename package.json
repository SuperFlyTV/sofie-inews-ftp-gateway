{
  "name": "@tv2media/inews-gateway",
  "version": "46.2.0",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "contributors": [
    {
      "name": "Johan Nyman",
      "email": "johan@superfly.tv",
      "url": "http://superfly.tv"
    },
    {
      "name": "Stephan Nordnes Eriksen",
      "url": "https://github.com/stephan-nordnes-eriksen"
    }
  ],
  "engines": {
    "npm": ">=6.14.4",
    "node": ">=20.18.0"
  },
  "author": "SuperFly.tv",
  "scripts": {
    "start": "cross-env NODE_ENV=production node ./dist",
    "start:dev": "cross-env NODE_ENV=development node ./dist",
    "start:local": "cross-env NODE_ENV=local node ./dist",
    "info": "npm-scripts-info",
    "build": "trash dist && yarn build:main",
    "build:dev": "trash dist && yarn build:main",
    "buildstart": "yarn build && yarn start",
    "buildstart:dev": "yarn build:dev && DEV=true yarn start",
    "buildinspect": "yarn build && yarn inspect",
    "buildinspect:dev": "yarn build && DEV=true yarn inspect",
    "build:main": "tsc -p tsconfig.json",
    "lint": "yarn lint:eslint && yarn lint:prettier",
    "lint-fix": "prettier --write .",
    "unit": "jest --coverage",
    "test": "yarn lint && yarn unit",
    "test:integration": "yarn lint && jest --config=jest-integration.config.js",
    "watch": "jest --watch",
    "cov": "jest; open-cli coverage/lcov-report/index.html",
    "cov-open": "open-cli coverage/lcov-report/index.html",
    "send-coverage": "jest && codecov",
    "changelog": "standard-version",
    "inspect": "node --inspect dist/index.js",
    "release": "yarn reset && yarn test && yarn changelog",
    "reset": "git clean -dfx && git reset --hard && yarn",
    "ci": "yarn test",
    "validate:dependencies": "yarn npm audit --environment production",
    "license-validate": "sofie-licensecheck",
    "unlinkall": "yarn unlink @sofie-automation/server-core-integration && yarn --check-files",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint:fix": "yarn lint:eslint --fix && yarn lint:prettier --write",
    "prepare": "husky"
  },
  "scripts-info": {
    "info": "Display information about the scripts",
    "build": "(Trash and re)build the library",
    "lint": "Lint all typescript source files",
    "unit": "Build the library and run unit tests",
    "test": "Lint, build, and test the library",
    "watch": "Watch source files, rebuild library on changes, rerun relevant tests",
    "cov": "Run tests, generate the HTML coverage report, and open it in a browser",
    "docs": "Generate HTML API documentation and open it in a browser",
    "docs:publish": "Generate HTML API documentation and push it to GitHub Pages",
    "docs:json": "Generate API documentation in typedoc JSON format",
    "changelog": "Bump package.json version, update CHANGELOG.md, tag a release",
    "reset": "Delete all untracked files and reset the repo to the last commit",
    "release": "Clean, build, test, publish docs, and prepare release (a one-step publish process)",
    "ci": "Test script for running by the CI (CircleCI)",
    "validate:dependencies": "Scan dependencies for vulnerabilities and check licenses"
  },
  "license": "MIT",
  "dependencies": {
    "@sofie-automation/blueprints-integration": "26.9.3",
    "@sofie-automation/server-core-integration": "26.9.3",
    "@sofie-automation/shared-lib": "26.9.3",
    "@tv2media/inews": "git+https://github.com/superflytv/node-inews.git#2712651ec37bf0dad414988eea9f6322b0c04f52",
    "@tv2media/logger": "^1.2.4",
    "async-mutex": "^0.5.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "tslib": "^2.9.1",
    "underscore": "^1.13.8",
    "xml2js": "^0.6.2",
    "yargs": "^18.2.0"
  },
  "resolutions": {
    "minimist": "^1.2.3",
    "set-value": "^4.0.1",
    "ansi-regex": "^5.0.1"
  },
  "devDependencies": {
    "@sofie-automation/code-standard-preset": "^4.0.3",
    "@types/dotenv": "^8.2.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/underscore": "^1.13.0",
    "@types/xml2js": "^0.4.14",
    "@types/yargs": "^17.0.35",
    "codecov": "^3.8.3",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "node-license-validator": "^1.3.2",
    "npm-scripts-info": "^0.3.9",
    "open-cli": "^6.0.1",
    "prettier": "^3.9.10",
    "standard-version": "^9.5.0",
    "trash-cli": "^7.2.0",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "standard-version": {
    "message": "chore(release): %s [skip ci]",
    "tagPrefix": ""
  },
  "packageManager": "yarn@4.14.1",
  "prettier": "./prettier.config.mjs",
  "lint-staged": {
    "*.{css,json,md,scss}": [
      "prettier --check"
    ],
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint"
    ]
  }
}
